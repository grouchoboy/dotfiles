# command = /usr/bin/zsh 
theme = Gruvbox Light Hard
# font-family = CaskaydiaCove Nerd Font
font-family = JetBrainsMono Nerd Font
font-size = 15
font-style-bold = false
font-feature = -calt
font-feature = -liga
font-feature = -dlig
cursor-style-blink = false
cursor-style = block
shell-integration-features = no-cursor,no-title

tab-inherit-working-directory = true

window-padding-x = 5
window-padding-y = 5
window-decoration = none

# Render unfocused splits identical to focused (no dim/blur effect)
unfocused-split-opacity = 1

# keybindings

keybind = f6=new_split:right
keybind = f7=new_split:down

keybind = ctrl+up=goto_split:up
keybind = ctrl+down=goto_split:down
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right

