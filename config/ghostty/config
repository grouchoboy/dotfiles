# command = /usr/bin/zsh 
theme = Gruvbox Light Hard
font-family = GoMono Nerd Font Mono
font-size = 16
font-style-bold = false
font-feature = -calt
font-feature = -liga
font-feature = -dlig
cursor-style-blink = false
cursor-style = block
shell-integration-features = no-cursor

tab-inherit-working-directory = true

window-padding-x = 5
window-padding-y = 5
window-decoration = none

# Render unfocused splits identical to focused (no dim/blur effect)
unfocused-split-opacity = 1

# keybindings

keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+l=goto_split:left
keybind = ctrl+shift+h=goto_split:right

